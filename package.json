{
  "name": "lenore",
  "private": true,
  "version": "0.1.0",
  "description": "Lenore: a graveyard for your code. A codebase as a living night-time 3D graveyard. Kiroween 2026 Costume Contest entry.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:pbt": "node --experimental-strip-types --test tests/pbt/*.test.ts",
    "scan": "node scripts/scan-repo.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "postprocessing": "^6.36.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
